rules_version = '2';

// Sicherheitsregeln für die Online-Bestenliste (Konzept Kap. 7.9 / Kap. 10).
// In der Firebase-Konsole einfügen: Firestore Database → Regeln → alles ersetzen → Veröffentlichen.
//
// - Lesen: alle (die Bestenliste ist öffentlich)
// - Schreiben: nur NEUE Einträge mit gültigen Werten (Nickname 3–15 Zeichen, Punkte 0–600)
// - Ändern und Löschen: niemand (so kann man fremde Scores nicht verändern)
// Ohne Login lässt sich Schummeln nicht ganz verhindern – für ein Schulprojekt bewusst so in Kauf genommen.

service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(
                         ['nickname', 'punkte', 'kategorie', 'kategorieId', 'schwierigkeit', 'anzahl', 'richtige', 'datum'])
                    && request.resource.data.nickname is string
                    && request.resource.data.nickname.size() >= 3
                    && request.resource.data.nickname.size() <= 15
                    && request.resource.data.punkte is int
                    && request.resource.data.punkte >= 0
                    && request.resource.data.punkte <= 600
                    && request.resource.data.anzahl is int
                    && request.resource.data.anzahl >= 5
                    && request.resource.data.anzahl <= 20;

      allow update, delete: if false;
    }
  }
}
